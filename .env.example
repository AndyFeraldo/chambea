# Copia este archivo como .env y ajusta los valores.

# Proveedor de IA: "mock" (palabras clave, sin modelo) o "qvac" (modelo local con QVAC).
AI_PROVIDER=mock

# Servidor QVAC compatible con OpenAI (se levanta con: npx @qvac/cli serve --openai)
QVAC_BASE_URL=http://127.0.0.1:11434
QVAC_MODEL=chambea-llm
# Solo si el servidor QVAC se levantó con --api-key
QVAC_API_KEY=

# Enlaces oficiales del MTPE (si se dejan vacíos, se usan estos mismos).
EMPLEOS_PERU_URL=https://www.empleosperu.gob.pe/
# Capacíta-T: plataforma de cursos gratuitos del MTPE
CAPACITATE_PERU_URL=https://capacitacionlaboral.trabajo.gob.pe/

# Puerto del backend
PORT=3001
